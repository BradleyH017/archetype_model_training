// Pipeline parameters and per-process resource overrides.
// Load via: nextflow run workflow/main.nf -profile sanger -c conf/nextflow.config

params {

    // ── Input data ────────────────────────────────────────────────────────────
    anndata          = "/lustre/scratch125/humgen/projects_v2/ibdresponse/analysis/bradley_analysis/archetypal_analysis_from_mrvi/results/objects/adata_plus_archetypes.h5ad"
    archetype_scores = "/lustre/scratch125/humgen/projects_v2/ibdresponse/analysis/bradley_analysis/archetypal_analysis_from_mrvi/results/tables/sample_archetype_scores.txt.gz"

    // ── AnnData column names ──────────────────────────────────────────────────
    // Column in adata.obs containing merged cluster IDs (must match prefixes A,B,C,D,E)
    cluster_col      = "clustered_celltypes"
    // Column in adata.obs containing per-sample IDs (must match archetype_scores 'sample' col)
    sample_col       = "pool_participant"
    // Column in adata.obs containing fine-grained cell-type labels (for abundance features)
    celltype_col     = "Celltypist:IBDverse_eqtl:predicted_labels"

    // ── Celltype→cluster map ──────────────────────────────────────────────────
    // TSV with columns (celltype, clustered_celltypes). When provided, cells are
    // additionally filtered to those whose celltype maps to the target cluster.
    // Set to "" or "null" to skip this filter.
    celltype_cluster_map = "/lustre/scratch125/humgen/projects_v2/ibdresponse/analysis/bradley_analysis/mrVI/results/tables/celltype_to_cluster_map-from_Celltypist:IBDverse_eqtl:predicted_labels.txt.gz"

    // ── Archetype target variant ────────────────────────────────────────────────
    // "raw" : use raw simplex weight columns from archetype_scores, e.g. B1, B2, B3, B4
    // "pca" : use CLR-PCA transformed columns, e.g. B1_clr_pca, B2_clr_pca, B3_clr_pca
    raw_or_clr_pca = "pca"

    // ── Feature engineering ───────────────────────────────────────────────────
    // hvg_pct/hvg_max are consumed by TRAIN_TREE_MODELS/TRAIN_MIL (per outer CV
    // fold, from that fold's training samples only), NOT by PREPARE_DATA —
    // selecting HVGs before any train/test split exists would rank genes using
    // samples that later become test data. See helpers.select_hvgs.
    hvg_pct             = 1   // fraction of candidate genes to keep as HVGs
    hvg_max             = 10000   // hard ceiling on number of HVGs
    pseudobulk_agg      = "mean" // "mean" | "sum" — also used by TRAIN_MIL to pseudobulk each fold's training bags for HVG ranking
    min_sample_pct      = 0.2    // keep genes expressed (> 0) in >= this fraction of pseudo-bulk samples (0.2 = 20%); set to 0 to skip
    include_abundance   = "true" // "true" | "false"
    abundance_type      = "global" // "within_cluster" | "global" | "both"

    // ── Model selection ───────────────────────────────────────────────────────
    run_xgboost    = "true"
    run_rf         = "true"
    run_mil        = "false"
    // Joint multi-task fits (MultiTaskElasticNet / MultiTaskLasso): one shared,
    // regularized fit per cluster across all its archetype targets, with a
    // per-archetype coefficient kept for feature-level interpretation.
    run_elasticnet = "true"
    run_lasso      = "true"
    // When raw_or_clr_pca == "pca", ALSO fit an independent single-output
    // ElasticNet/Lasso per target ("elasticnet_indep"/"lasso_indep" — no shared
    // feature support across targets) to compare against the joint fits above.
    // PCA targets are orthogonal by construction, which weakens the multi-task
    // assumption that targets share a common feature support — this flag lets
    // you check empirically whether joint or independent fits do better.
    // No effect when raw_or_clr_pca == "raw".
    run_independent_pca_fits = "true"

    // ── Label modes — one job per enabled mode × model ────────────────────────
    // full            : continuous archetype weights (original behaviour)
    // argmax          : one-hot at dominant archetype, full cohort
    // argmax_filtered : one-hot at dominant archetype, samples with max weight > min_score
    // argmax modes are currently disabled pipeline-wide; only 'full' is run.
    run_label_full            = "true"
    run_label_argmax          = "false"
    run_label_argmax_filtered = "false"
    min_score                 = 0.5    // threshold for argmax_filtered

    // ── Cross-validation ──────────────────────────────────────────────────────
    n_outer_folds    = 5
    n_inner_folds    = 5
    n_hpo_iter_tree  = 50  // RandomizedSearch iterations per outer fold (XGB/RF)
    n_hpo_iter_mil   = 20  // fewer for MIL (each fit is expensive)
    random_seed      = 42

    // ── Parallelism ─────────────────────────────────────────────────────────
    // XGBoost's inner search (up to n_hpo_iter_tree x n_inner_folds independent
    // fits per outer fold) was the actual bottleneck behind the TERM_RUNLIMIT
    // (exit 140) failures — parallelize it directly via RandomizedSearchCV's
    // own n_jobs, rather than only relying on each individual fit's internal
    // threading. Applied only to xgboost (see workflow/main.nf) so every other
    // model's already-completed -resume cache entries are left untouched.
    n_jobs_inner_xgboost = 8

    // ── MIL-specific ──────────────────────────────────────────────────────────
    max_cells_per_bag = 2000  // subsample cells per sample if above this threshold

    // ── Output ────────────────────────────────────────────────────────────────
    outdir = "${launchDir}/results"

    // ── Singularity containers ────────────────────────────────────────────────
    // container_ml:    scanpy, anndata, xgboost, scikit-learn, scipy, h5py,
    //                  matplotlib, seaborn, pandas, numpy
    // container_torch: above + pytorch (cpu or cuda)
    // Update these paths to point to your built .sif files.
    container_ml    = "/software/hgi/softpack/installs/users/eh19//BioAUTOMATED/1-scripts/singularity.sif"
    container_torch = "/software/hgi/softpack/installs/users/eh19//BioAUTOMATED/1-scripts/singularity.sif"

    tmpdir = "${launchDir}/work"
}

process {
    containerOptions = "--cleanenv --containall -B ${params.tmpdir}:/tmp"

    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139, 140] ? 'retry' : 'finish' }
    maxRetries    = 3
    maxErrors     = '-1'

    withName: 'SPLIT_BY_CLUSTER|PREPARE_DATA' {
        container = "/software/hgi/softpack/installs/users/eh19//test-scvi-reserve/33-scripts/singularity.sif"
    }

    // SPLIT_BY_CLUSTER: loads the full AnnData once — needs substantial RAM
    withLabel: 'mem_100gb' {
        memory = { 100.GB * task.attempt }
        time   = { 6.h   * task.attempt }
        queue  = { task.attempt > 1 ? 'long' : 'normal' }
    }
    // PREPARE_DATA (one per-cluster subset, not the full AnnData) + tree model
    // training (nested CV, multi-output regression). Tune down if per-cluster
    // AnnData subsets are much smaller than 32GB.
    withLabel: 'mem_32gb' {
        // 8 matches n_jobs_inner_xgboost above. This is a resource directive,
        // not baked into any task's rendered script, so bumping it does NOT
        // affect -resume caching for already-completed jobs of any model.
        cpus   = 8
        memory = { 32.GB  * task.attempt }
        time   = { 12.h   * task.attempt }
        queue  = { task.attempt > 1 ? 'long' : 'normal' }
    }
    // MIL training: neural net, cell-level bags, GPU optional
    withLabel: 'mem_64gb' {
        memory = { 64.GB  * task.attempt }
        time   = { 24.h   * task.attempt }
        queue  = 'long'
    }
    // Evaluation and aggregation
    withLabel: 'mem_8gb' {
        memory = { 8.GB  * task.attempt }
        time   = { 2.h   * task.attempt }
        queue  = { task.attempt > 1 ? 'long' : 'normal' }
    }
}
